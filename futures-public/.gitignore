# data is rebuilt by the pipeline and never committed
data/
# console logs from reproduce.sh (machine paths, warnings); the results they
# produced live in reports/ and are tracked
reports/*.log
# never commit credentials, environment files or hosts
.env
.env.*
*.key
*.pem
keys/
secrets/
hosts*
# python
__pycache__/
*.pyc
.DS_Store
.Rhistory
